{
  "manifest_version": 3,
  "name": "ApplyPilot Dev",
  "version": "0.0.1",
  "key": "",
  "oauth2": {
    "client_id": "294371060360-3s12db5jkllfqhgil11a79cmmj246a0l.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },
  "permissions": ["activeTab", "scripting", "storage", "debugger", "identity", "tabs"],
  "host_permissions": [
    "*://*.myworkdayjobs.com/*",
    "*://*.myworkdaysite.com/*",
    "https://www.linkedin.com/*",
    "https://app.joinhandshake.com/*",
    "https://raw.githubusercontent.com/*",
    "https://gmail.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "http://localhost/*",
    "https://applypilot.vercel.app/*"
  ],
  "externally_connectable": {
    "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://applypilot.vercel.app/*"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
