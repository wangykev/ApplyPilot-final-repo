# ApplyPilot Web — environment
# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service-role key — SERVER ONLY (used by API routes for privileged inserts,
# e.g. the extension ingest endpoint). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- App ---
# The public origin of this site (used in OAuth redirect + the extension
# externally_connectable matches). Local dev default below.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Chrome extension id users connect to. Optional: users can also paste it
# on the Connect page. Leave blank for v1 (paste-the-id flow).
NEXT_PUBLIC_EXTENSION_ID=

# Path to a local TeX engine (tectonic single binary — no admin install) for the
# tailor page's "LaTeX PDF" compile: the tailored resume in the operator's EXACT
# sb2nov template. Runs on the machine hosting the site (local dev); a serverless
# deploy (Vercel) cannot run it — use a compile container there, or skip (the
# Quick-PDF print path and the .tex download need no engine).
# Get it: https://github.com/tectonic-typesetting/tectonic/releases
TECTONIC_PATH=
