# Sensitive data — keep real credentials, profile PII, and the resume out of git.
# Deny-by-default for data/: everything in the folder is ignored unless it is
# explicitly allow-listed below. Drop new secrets in here freely; git won't see
# them. Only example/template files are tracked.
data/*
!data/credentials.example.json
!data/profile.example.json
!data/application_defaults.json
!data/question_mapping_schema.json

# Dev tooling (tests) — the extension itself ships no node_modules.
node_modules/

# Any local secrets dropped in secrets/ (guard). NOTE: the extension SIGNING KEY
# (ext-key.pem) is stored OUTSIDE this folder entirely — Chrome warns if a .pem sits
# in a loaded unpacked extension, and it must never be packaged. See docs/gmail-setup.md.
secrets/

# OS / editor noise
.DS_Store
Thumbs.db

# Claude Code worktrees live OUTSIDE this repo (see .claude/settings.local.json
# WorktreeCreate hook). Never track worktree contents — build output, deps, copies.
.claude/worktrees/

# local dev-server log (never commit)
web/nextdev.log
